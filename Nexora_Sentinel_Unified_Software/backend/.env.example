# Nexora Sentinel backend-only environment template
# Copy this file to backend/.env and put real sandbox keys there.
# Never paste secrets into frontend/index.html.

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BUSINESS_ACCOUNT=your_business_sandbox_email
PAYPAL_BUSINESS_ACCOUNT_ID=your_business_account_id
PAYPAL_BUSINESS_PASSWORD=your_business_sandbox_password
PAYPAL_PERSONAL_ACCOUNT=your_personal_sandbox_email
PAYPAL_PERSONAL_ACCOUNT_ID=your_personal_account_id
PAYPAL_PERSONAL_PASSWORD=your_personal_sandbox_password

EXPONEA_BASE_URL=https://uqa.app.exponea.dev
EXPONEA_PROJECT_TOKEN=wobbly-lobster
EXPONEA_API_KEY=your_exponea_key
EXPONEA_ENGAGEMENT_URL=https://uqa.app.exponea.dev/p/wobbly-lobster
BLOOMREACH_STOREFRONT_URL=https://sandbox-sales11.bloomreach.com/wobbly-lobster
BLOOMREACH_STOREFRONT_API_KEY=your_storefront_key
BLOOMREACH_MCP_URL=https://loomi-mcp-alpha.bloomreach.com/mcp/
BLOOMREACH_MCP_API_KEY=your_loomi_mcp_key
BLOOMREACH_CONVERSATION_MCP_URL=your_conversation_mcp_url
BLOOMREACH_CONVERSATION_API_KEY=your_conversation_key

AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=

MANDATE_TOKEN_SECRET=change_this_secret
MANDATE_EXPIRY_MINUTES=30
AUDIT_ENCRYPTION_KEY=change_this_audit_key
RISK_THRESHOLD_SCORE=75

PORT=8000
HOST=0.0.0.0
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE_FALLBACK=true

# Keep false for fast demo/offline fallback. Set true only when testing real sandbox calls.
LIVE_API_CALLS=false
